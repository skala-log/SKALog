# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# --- 데이터베이스 (docker-compose 와 애플리케이션이 함께 사용) ---
POSTGRES_DB=skalog
POSTGRES_USER=skalog
POSTGRES_PASSWORD=skalog

DB_URL=jdbc:postgresql://localhost:5432/skalog
DB_USERNAME=skalog
DB_PASSWORD=skalog

# --- 슬랙 (1단계 로그인, 4단계 수집기에서 사용) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# 자료 수집 대상 채널 ID, 콤마로 여러 개 (예: C0123ABC,C0456DEF)
SLACK_MATERIAL_CHANNEL_IDS=

# --- Gemini (공지 한 줄 요약, 무료 티어) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
